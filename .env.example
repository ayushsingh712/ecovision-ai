# EcoVision AI configuration. Copy to .env and adjust as needed.
# All settings use the ECOVISION_ prefix.

# Optional explicit checkpoint path. When empty, the backend resolves:
# manifest -> final checkpoint -> smoke checkpoint.
ECOVISION_MODEL_PATH=
ECOVISION_MODEL_DIR=ml/models
ECOVISION_EVALUATION_DIR=ml/evaluation
ECOVISION_DEVICE=cpu

# External model weights (Hugging Face Hub). Leave HF_REPO empty to use local
# checkpoints only. A token is only needed for private repositories.
ECOVISION_HF_REPO=
ECOVISION_HF_FILENAME=mobilenet_v2_best.pt
ECOVISION_HF_MANIFEST_FILENAME=model_manifest.json
ECOVISION_HF_METRICS_FILENAME=metrics.json
ECOVISION_HF_TOKEN=
ECOVISION_FETCH_MODEL=true

# Runtime storage. DB_PATH and UPLOAD_DIR default to files under DATA_DIR.
ECOVISION_DATA_DIR=data
ECOVISION_DB_PATH=
ECOVISION_UPLOAD_DIR=
ECOVISION_MAX_UPLOAD_MB=8
ECOVISION_MAX_CONCURRENT_INFERENCE=2

# Classification request budget. Grad-CAM is generated separately so it can
# never consume this budget.
ECOVISION_INFERENCE_TIMEOUT_SECONDS=20
# 1 is fastest for single-image CPU inference; 0 uses all cores.
ECOVISION_TORCH_THREADS=1
ECOVISION_GRADCAM_ENABLED=true
ECOVISION_GRADCAM_TIMEOUT_SECONDS=30

# Serve the static frontend from FastAPI. Set false for separate deployments.
ECOVISION_SERVE_FRONTEND=true
ECOVISION_FRONTEND_DIR=frontend

# Comma-separated origins. Use an explicit origin list in production.
ECOVISION_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ECOVISION_LOG_LEVEL=INFO
ECOVISION_APP_ENV=development
